#!/usr/bin/env bash
# Fast pre-push gate; full policy (incl. `flutter test`) lives in docs/testing.md.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
changed=()
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch delete
  if [ "$remote_sha" = "$zero" ]; then
    range=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha~1")..$local_sha
  else
    range=$remote_sha..$local_sha
  fi
  while IFS= read -r f; do changed+=("$f"); done < <(git diff --name-only --diff-filter=ACMR "$range")
done
[ "${#changed[@]}" -eq 0 ] && exit 0

dart_files=() md_files=()
for f in "${changed[@]}"; do
  case "$f" in
    *.g.dart | lib/l10n/*) ;;
    lib/*.dart | test/*.dart) [ -f "$f" ] && dart_files+=("$f") ;;
    *.md) [ -f "$f" ] && md_files+=("$f") ;;
  esac
done

if [ "${#md_files[@]}" -gt 0 ]; then
  scripts/check_doc_links.sh "${md_files[@]}"
fi

if [ "${#dart_files[@]}" -gt 0 ]; then
  # Only pushed files: formatting the whole tree reflows unrelated files.
  dart format --output=none --set-exit-if-changed "${dart_files[@]}"
  flutter analyze --no-pub
fi
